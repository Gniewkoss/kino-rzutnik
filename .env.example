# Adres MongoDB (np. Atlas). Bez niego serwer startuje z bazą w pamięci (tylko do developmentu).
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net
MONGODB_DB=kino
PORT=3000
# Czas ważności rezerwacji w sekundach: 900 = 15 min (produkcja), 120 = 2 min (tryb testowy)
RESERVATION_TTL_SECONDS=120
# Limit rezerwacji na jednego klienta (IP) w oknie czasowym
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=10000
# Ile proxy stoi przed aplikacją (Render: 3, sprawdź w /api/health). Potrzebne do poprawnego IP klienta.
TRUST_PROXY=1
# Stripe, wyłącznie tryb testowy. Klucz sk_live_ zatrzymuje start serwera.
STRIPE_SECRET_KEY=sk_test_...
# Lokalnie sekret podaje `stripe listen`; na wdrożeniu jest przy endpoincie w panelu Stripe'a
STRIPE_WEBHOOK_SECRET=whsec_...
# Adres sklepu do powrotów ze Stripe'a. Na Render ustawia się sam (RENDER_EXTERNAL_URL).
PUBLIC_URL=http://localhost:3000
# Zakup bez płatności z etapu I, tylko do testów (npm run chaos)
ALLOW_DIRECT_PURCHASE=false
