# Adres MongoDB (np. Atlas). Bez niego serwer startuje z bazą w pamięci (tylko do developmentu).
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net
MONGODB_DB=kino
PORT=3000
# Czas ważności rezerwacji w sekundach: 900 = 15 min (produkcja), 120 = 2 min (tryb testowy)
RESERVATION_TTL_SECONDS=120
# Limit rezerwacji na jednego klienta (IP) w oknie czasowym
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=10000
# Ile proxy stoi przed aplikacją (Render/Railway/Fly: 1). Potrzebne do poprawnego IP klienta.
TRUST_PROXY=1
